# ==============================================================
# Docker Deployment Environment Configuration (.env)
# Copy this file to .env in the project root before running docker compose
# ==============================================================

# 1. Cloud Database Connection (Required)
# E.g. Neon, AWS RDS, Supabase, DigitalOcean Postgres
DATABASE_URL=postgresql://<user>:<password>@<cloud-postgres-host>:5432/<dbname>?sslmode=require

# 2. JWT Secrets (Required - minimum 32 characters each)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-random-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-random-refresh-secret

# 3. Security & Auth Settings
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# 4. CORS & Port Mappings
# Change CORS_ORIGIN to your frontend domain in production (e.g. https://erp.yourcollege.edu)
CORS_ORIGIN=http://localhost:3000
BACKEND_PORT=3001
FRONTEND_PORT=3000

# 5. Frontend Public API URLs (Baked during frontend build)
# In production, set to your public backend domain or reverse-proxy path
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
