# ==============================================================================
# College ERP System - Environment Configuration Template
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Generate strong secrets for JWT keys using:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 3. Update passwords and host IP addresses as appropriate for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=erp_db
POSTGRES_USER=erp_admin
# Replace with a strong, generated password (do not leave default)
POSTGRES_PASSWORD=replace_with_a_secure_database_password_123

# ------------------------------------------------------------------------------
# 2. Backend Security & JWT Settings
# ------------------------------------------------------------------------------
# Must be at least 32 characters long
JWT_ACCESS_SECRET=replace_with_generated_64_char_hex_access_secret_0123456789abcdef
JWT_REFRESH_SECRET=replace_with_generated_64_char_hex_refresh_secret_0123456789abcdef

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma-separated list of allowed CORS origins
# If accessing from another machine in the college lab, add: http://<LAB_IP>:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 3. Frontend Client-Facing API & WebSocket URLs
# ------------------------------------------------------------------------------
# In the lab, if running locally on the lab machine:
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# If accessing from a secondary machine across the lab local network (LAN),
# change 'localhost' to the host machine's LAN IP address (e.g. 192.168.1.105):
# NEXT_PUBLIC_API_URL=http://192.168.1.105:3001/api
# NEXT_PUBLIC_SOCKET_URL=http://192.168.1.105:3001
